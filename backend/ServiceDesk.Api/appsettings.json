{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=ServiceDeskDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "ServiceDesk.Api",
    "Audience": "ServiceDesk.Client",
    "ExpiryMinutes": 60
  },
  "Cors": { "AllowedOrigins": [ "http://localhost:4200" ] },
  "Email": {
    "Enabled": false,
    "Host": "smtp.example.com",
    "Port": 587,
    "Username": "",
    "Password": "",
    "From": "servicedesk@example.com",
    "EnableSsl": true
  },
  "Storage": { "UploadPath": "Uploads", "MaxFileSizeMb": 5 },
  "Database": { "AutoCreate": true, "SeedDemoData": true },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/servicedesk-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 } }
    ]
  },
  "AllowedHosts": "*"
}
